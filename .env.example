# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restaurantos?schema=public"
# Generate a long random secret: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
APP_URL="http://localhost:3000"
# Optional Razorpay sandbox/live credentials. Keep secrets server-side.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Set true only for local development seed/demo flows
ALLOW_DEMO_SEED="true"
